---
interface Props {
  role: string;
  org: string;
  country: string;
  start: string;
  end?: string;
  bullets: string[];
}

const { role, org, country, start, end, bullets } = Astro.props;
---

<li>
  <p class="mono-sm">
    {start} .. {end ?? 'now'}<br />
    {country}
  </p>
  <div>
    <h3>
      {role} <span class="org">at {org}</span>
      {!end && <span class="cur">current</span>}
    </h3>
    <ul>
      {bullets.map((b) => <li>{b}</li>)}
    </ul>
  </div>
</li>
