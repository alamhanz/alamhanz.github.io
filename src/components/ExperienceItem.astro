---
interface Props {
  role: string;
  org: string;
  country: string;
  start: string;
  end?: string;
  bullets: string[];
}

const { role, org, country, start, end, bullets } = Astro.props;

const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fmt = (ym: string) => {
  const [y, m] = ym.split('-');
  return `${months[Number(m) - 1]} ${y}`;
};
---

<li>
  <p class="mono-sm">
    <time datetime={start}>{fmt(start)}</time> &ndash; {end ? <time datetime={end}>{fmt(end)}</time> : 'now'}<br />
    {country}
  </p>
  <div>
    <h3>
      {role} <span class="org">at {org}</span>
      {!end && <span class="cur">current</span>}
    </h3>
    <ul>
      {bullets.map((b) => <li>{b}</li>)}
    </ul>
  </div>
</li>
