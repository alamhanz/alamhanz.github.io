---
import Icon from './Icon.astro';

const path = Astro.url.pathname.replace(/(\/index)?(\.html)?\/?$/, '') || '/';
const links = [
  { href: '/', label: 'home' },
  { href: '/about', label: 'about' },
  { href: '/blog', label: 'blog' },
  { href: '/cv', label: 'cv' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<header class="site-head">
  <div class="wrap">
    {path !== '/' && <a class="mark" href="/">Alamsyah Hanza</a>}
    <nav aria-label="Primary" class="ml-auto">
      <button id="toggle" class="menu-btn" type="button" aria-controls="nav" aria-expanded="false" aria-label="Menu">
        <Icon name="menu-2" class="size-6 toggle-open" />
        <Icon name="x" class="size-6 toggle-close hidden" />
      </button>
      <ul id="nav" class="nav" data-open="false">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('toggle');
  const nav = document.getElementById('nav');

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      nav.dataset.open = String(open);
      toggle.querySelector('.toggle-open')?.classList.toggle('hidden', open);
      toggle.querySelector('.toggle-close')?.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    nav.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
