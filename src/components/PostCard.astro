---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
---

<article class="card">
  <time class="text-sm opacity-70" datetime={pubDate.toISOString()}>
    {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
  </time>
  <h3 class="font-poppins font-semibold text-lg md:text-xl mt-1">
    <a class="hover:text-selected-text" href={`/blog/${post.id}`}>{title}</a>
  </h3>
  <p class="mt-2 leading-relaxed">{description}</p>
  {
    tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2 text-xs">
        {tags.map((t) => (
          <li class="rounded-full bg-theme/10 px-2.5 py-1">{t}</li>
        ))}
      </ul>
    )
  }
</article>
