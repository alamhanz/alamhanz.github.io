---
import { site } from '../data/site';
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
---

<footer class="bg-white shadow p-5 md:p-6">
  <div class="mx-auto max-w-5xl md:flex md:items-center md:justify-between gap-4">
    <span class="text-sm">&copy; {new Date().getFullYear()} alamhanz. All Rights Reserved.</span>
    <div class="mt-3 md:mt-0 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
      <a class="text-link" href={site.mediumUrl} rel="noopener">Older posts on Medium</a>
      <a class="text-link inline-flex items-center gap-1" href="/rss.xml">
        <Icon name="rss" class="size-4" /> RSS
      </a>
      <SocialLinks class="justify-start" />
    </div>
  </div>
</footer>
