---
import type { CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, coverAlt } = post.data;
const og = cover ? await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpeg' }) : undefined;
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout title={`${title} | Alamsyah Hanza`} description={description} path={`/blog/${post.id}`} type="article" image={og?.src} imageWidth={og ? 1200 : undefined} imageHeight={og ? 630 : undefined}>
  <article class="pt-12 md:pt-16">
    <a class="link text-sm" href="/blog">&larr; All posts</a>
    <h1 class="font-bold text-4xl md:text-6xl leading-tight mt-6" style="letter-spacing:-0.03em">{title}</h1>
    <p class="mono-sm mt-4">
      <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
      {updatedDate && <span> .. updated <time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time></span>}
    </p>
    {
      tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {tags.map((t) => (
            <li class="tag">#{t}</li>
          ))}
        </ul>
      )
    }
    {
      cover && (
        <Image src={cover} alt={coverAlt} width={1200} height={630} fit="cover" class="mt-8 w-full h-auto border border-theme/20" loading="eager" />
      )
    }
    <div
      class="prose prose-lg mt-10 mb-8 max-w-[68ch] prose-headings:font-poppins prose-headings:text-theme prose-a:text-theme prose-a:decoration-accent prose-a:decoration-2 prose-a:underline-offset-4 hover:prose-a:text-accent-ink prose-strong:text-theme prose-code:text-theme prose-code:before:content-none prose-code:after:content-none text-theme"
    >
      <slot />
    </div>
  </article>
</BaseLayout>
