---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title={`${title} | Alamsyah Hanza`} description={description} path={`/blog/${post.id}`} type="article">
  <article>
    <a class="text-link text-sm" href="/blog">&larr; All posts</a>
    <h1 class="font-poppins font-bold text-4xl md:text-6xl leading-tight mt-6">{title}</h1>
    <p class="mt-4 text-sm opacity-70">
      <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
      {updatedDate && <span> &middot; updated <time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time></span>}
    </p>
    {
      tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2 text-xs">
          {tags.map((t) => (
            <li class="rounded-full bg-theme/10 px-2.5 py-1">{t}</li>
          ))}
        </ul>
      )
    }
    <div
      class="prose prose-lg mt-10 max-w-[68ch] prose-headings:font-poppins prose-headings:text-theme prose-a:text-theme prose-a:underline-offset-4 hover:prose-a:text-selected-text prose-strong:text-theme prose-code:text-theme text-theme"
    >
      <slot />
    </div>
  </article>
</BaseLayout>
